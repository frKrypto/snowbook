# Copy to .env.local and fill in. Never commit the filled-in file.

# ---------------------------------------------------------------------------
# Supabase — Project Settings → API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses row level security, so it must never be exposed to the
# browser or prefixed with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Absolute origin used to build invite links. On Vercel this is inferred, but
# set it explicitly for a custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CURRENCY=USD

# ---------------------------------------------------------------------------
# PayPal — developer.paypal.com → Apps & Credentials
# ---------------------------------------------------------------------------
# Leave the PayPal values blank to run without payments: the portal shows a
# "contact the studio" note instead of the pay button.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "sandbox" (default) or "live"
PAYPAL_ENV=sandbox
# From the webhook you create for PAYMENT.CAPTURE.COMPLETED
PAYPAL_WEBHOOK_ID=

# ---------------------------------------------------------------------------
# Seed script (optional)
# ---------------------------------------------------------------------------
SEED_CLIENT_PASSWORD=snowbook-demo-2026
